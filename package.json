{
  "name": "alienbin",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Secure ephemeral text sharing for developers. Cloudflare Workers + D1.",
  "bin": {
    "alienbin": "./dist/cli/alienbin.mjs"
  },
  "scripts": {
    "dev": "npm run db:migrate:local && wrangler dev",
    "build": "vite build && node scripts/build-cli.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.worker.json --noEmit && tsc -p tsconfig.web.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "lint": "biome check src cli tests scripts",
    "lint:fix": "biome check --write src cli tests scripts",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 execute alienbin --local --file migrations/0001_initial.sql",
    "db:migrate:remote": "wrangler d1 execute alienbin --remote --file migrations/0001_initial.sql"
  },
  "dependencies": {
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "highlight.js": "^11.10.0",
    "hono": "^4.6.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20260823.1",
    "@types/node": "^22.10.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.0",
    "wrangler": "^4.0.0"
  }
}
